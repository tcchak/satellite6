## 7. Quick reference (copy/paste)

```bash
# --- remote hammer to disconnected ---
HAMMER_DISC=(hammer --server https://disconnected-satellite.example.com -u admin -p 'YOUR_DISCONNECTED_ADMIN_PASSWORD')
ORG=sampleorg

# list
"${HAMMER_DISC[@]}" repository list --organization "$ORG"
"${HAMMER_DISC[@]}" repository-set list --organization "$ORG" --enabled true

# sync all products that have repos
"${HAMMER_DISC[@]}" --csv product list --organization "$ORG" \
  | awk -F, 'NR>1 && $5+0 > 0 {print $2}' \
  | while IFS= read -r p; do
      "${HAMMER_DISC[@]}" product synchronize --name "$p" --organization "$ORG" --async
    done

# watch
"${HAMMER_DISC[@]}" task list --search 'state = running' --organization "$ORG"
```
